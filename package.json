{
  "name": "skemaka",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:mobile": "turbo dev --filter=mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "start": "npm run start --workspace=web",
    "test:e2e": "npm run test:e2e --workspace=web",
    "seed:e2e": "npm run seed:e2e --workspace=web",
    "screenshots": "npm run screenshots --workspace=web",
    "db:push": "npm run db:push --workspace=web",
    "db:generate": "npm run db:generate --workspace=web",
    "db:migrate": "npm run db:migrate --workspace=web",
    "db:seed": "npm run db:seed --workspace=web",
    "db:studio": "npm run db:studio --workspace=web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.19.4"
  }
}
