
# expo-router declares its native modules as `peerDependencies: "*"`. npm 7+
# auto-installs peers at the LATEST matching version, which lands a SECOND copy
# of react-native-screens / safe-area-context at the workspace root beside the
# SDK-pinned ones in apps/mobile. Two copies of a native module is a runtime
# crash ("Tried to register two views with the same name"), and the newest
# react-native-screens fails react-native 0.81 codegen outright.
#
# Turning off auto-peer-install leaves apps/mobile's own tilde pins as the only
# source, so exactly one copy is installed. Pinning at the workspace root
# instead does NOT work: it drags react-native to the root and breaks the web
# app's react/react-dom pairing.
legacy-peer-deps=true
