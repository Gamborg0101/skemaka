# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Pooled connection string used by Prisma at runtime (via PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection string — required for Prisma migrations on Neon
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Random secret used to sign/encrypt session tokens — generate with:
# openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Canonical URL of the app — used by Auth.js for callback URLs
NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key from the Stripe dashboard (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"

# Publishable key from the Stripe dashboard (starts with pk_live_ or pk_test_)
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# Webhook signing secret — from Stripe dashboard → Webhooks (starts with whsec_)
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Stripe Price ID for the per-active-employee plan (starts with price_).
# Volume-tiered recurring EUR price: flat €19.00/mo up to 5 units, €3.50/unit
# for 6+ (whole quantity), i.e. max(€19, units × €3.50). Checkout subscribes
# with quantity = active employee count; see lib/pricing.ts.
STRIPE_PRICE_ID="price_your-stripe-price-id"

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────────
# REST URL from Upstash console (https://console.upstash.com)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"

# REST token from Upstash console
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ─── Resend (transactional email) ────────────────────────────────────────────
# API key from Resend dashboard (https://resend.com/api-keys)
RESEND_API_KEY="re_your-resend-api-key"

# Verified sender address — must be from a domain verified in Resend
RESEND_FROM_EMAIL="noreply@skemaka.com"

# ─── Twilio (SMS notifications) ──────────────────────────────────────────────
# Account SID + auth token from the Twilio console (https://console.twilio.com).
# The inbound SMS webhook (STOP/START/HELP) is verified against TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"

# Sending number in E.164 format (e.g. +15551234567). Requires A2P 10DLC
# registration before carriers will reliably deliver in production.
TWILIO_FROM_NUMBER="+15551234567"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public-facing URL of the app — used for generating links in emails etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email address of the product owner — grants ADMIN JWT role, gates /platform routes,
# and receives bug-report notifications.
SUPERADMIN_EMAIL="your-admin-email@example.com"

# ─── Mobile auth ─────────────────────────────────────────────────────────────
# Lifetime (in seconds) of mobile session tokens issued by the refresh and
# Apple-native auth endpoints. Defaults to 1800 (30 minutes) if not set.
MOBILE_TOKEN_MAX_AGE=1800

# ─── Cron ────────────────────────────────────────────────────────────────────
# Bearer token that Vercel Cron (or any scheduler) must send in the Authorization
# header when calling /api/cron/cleanup.  Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
